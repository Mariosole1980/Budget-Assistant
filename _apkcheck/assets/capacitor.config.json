{
	"appId": "com.budgetassistant.app",
	"appName": "Budget Assistant",
	"webDir": "www",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true
	},
	"ios": {
		"backgroundColor": "#181b22"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#181b22",
			"launchShowDuration": 0
		},
		"Browser": {
			"androidScheme": "http"
		}
	}
}
