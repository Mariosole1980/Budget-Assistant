+            <span style="font-size: 11.5px; color: var(--text-secondary); margin-top: 3px; word-break: break-word; line-height: 1.2;">
+              ${formattedDate} • ${parseFloat(t.amount || 0).toFixed(2)}€ ${t.type === 'expense' ? '🔴' : t.type === 'income' ? '🟢' : '🔵'}
+            </span>
+          </div>
