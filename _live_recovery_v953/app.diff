+              minute: minutes
+            },
+            repeats: true,
+            allowWhileIdle: true
+          },
+          sound: null,
+          attachments: null,
+          actionTypeId: '',
+          extra: {
+            type: 'daily_reminder'
+          }
+        }
+      ]
+    });
+    console.log(`Daily reminder scheduled successfully for ${timeString}`);
+  } catch (err) {
+    console.error('Error scheduling daily reminder:', err);
+  }
+}
