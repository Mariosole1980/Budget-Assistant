<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- The main theme keeps a SOLID COLOR window background (matching the
             saved theme) for maximum compatibility — a large bitmap window
             background on the post-splash main theme is not needed: the branded
             splash PNG is applied explicitly in MainActivity.onCreate() and kept
             during the cold-start launch window by the coldStartInProgress guard
             in applySavedTheme(). -->
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#0F1219</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>