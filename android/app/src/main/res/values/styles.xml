<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!--
        Native launch window. On cold start this is the FIRST thing Android
        draws (before the WebView / HTML splash can render). It is intentionally
        a plain solid #171B26 screen with NO photo and NO icon so it visually
        melts straight into the HTML splash (splash.html, dark navy theme)
        instead of flashing a broken/stretched splash image.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#171B26</item>
        <item name="windowSplashScreenBackground">#171B26</item>
        <!-- splash_transparent.xml = empty 1x1 vector: forces Android 12+
             to render NO icon (not even the ic_launcher fallback), so the
             native launch window shows ONLY the dark #171B26 fill.
             Using @android:color/transparent as icon causes a fallback to
             ic_launcher on many OEMs — this is the reliable solution. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">#171B26</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>