<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!--
        Native launch window. On cold start this is the FIRST thing Android
        draws (before the WebView / HTML splash can render). It is intentionally
        a plain solid #171B26 screen with NO photo and NO icon so it visually
        melts straight into the HTML splash (splash.html, dark navy theme)
        instead of flashing a broken/stretched splash image.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">#171B26</item>
        <item name="windowSplashScreenBackground">#171B26</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>