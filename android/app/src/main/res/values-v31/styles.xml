<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ (API 31+) Splash API overrides.
         windowSplashScreenBackground controls the native launch window color.
         splash_solid_bg is a solid #171B26 rectangle — same color as the
         background, so the squircle container is invisible (Samsung-proof fix:
         Samsung OneUI ignores empty/transparent vectors and shows ic_launcher,
         but a solid fill matching the background blends in perfectly). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#171B26</item>
        <item name="windowSplashScreenBackground">#171B26</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_solid_bg</item>
        <!-- windowSplashScreenIconBackgroundColor intentionally omitted (see
             values/styles.xml) — it caused a visible splash-icon container
             flash on resume from background. -->
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
