<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully-transparent splash icon drawable.

  On Android 12+ the system splash screen always draws an icon. Using a real
  (fully transparent) drawable here — instead of "@android:color/transparent" —
  is the reliable way to suppress the icon: several OEM builds (Samsung,
  Xiaomi, …) don't treat a *color* resource as a valid splash icon and fall
  back to drawing the square launcher icon, which looked like a broken photo
  on cold start. A transparent vector draws nothing on every device/API level.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0 L24,0 L24,24 L0,24 Z" />
</vector>
