<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 8.0 – 11 (API 27–30): pre-Splash-API devices.
         The launch window is a plain solid #171B26 screen (no photo, no icon)
         so it transitions straight into the HTML splash instead of showing the
         old full-screen splash.png which looked stretched/broken on devices. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#171B26</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="windowSplashScreenBackground">#171B26</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
