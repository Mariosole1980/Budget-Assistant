<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 8.1 – 11 (API 27–30): pre-Splash-API devices.
         Must inherit from Theme.SplashScreen and provide postSplashScreenTheme
         so androidx.core.splashscreen.SplashScreen.installSplashScreen() initializes
         safely without throwing IllegalStateException on older Android / Xiaomi devices. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:background">@color/app_background</item>
        <item name="windowSplashScreenBackground">#171B26</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
