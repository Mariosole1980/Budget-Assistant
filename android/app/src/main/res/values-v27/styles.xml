<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 8.0 – 11 (API 27–30): pre-Splash-API devices.
         Uses the splash drawable as the window background so the launch window
         shows the branded splash image instead of a blank/black frame. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
